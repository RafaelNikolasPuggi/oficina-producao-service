# TEMPLATE — copie para 02-secret.yaml, preencha com valores reais e NUNCA
# commite o arquivo preenchido (02-secret.yaml está no .gitignore).
#
# Alternativa recomendada (sem deixar o segredo em disco):
#   kubectl create secret generic oficina-producao-app-secret -n oficina-producao \
#     --from-literal=DB_USERNAME=oficina_producao \
#     --from-literal=DB_PASSWORD='<senha-forte>' \
#     --from-literal=JWT_SECRET='<segredo-forte>'
apiVersion: v1
kind: Secret
metadata:
  name: oficina-producao-app-secret
  namespace: oficina-producao
type: Opaque
stringData:
  DB_USERNAME: 'oficina_producao'
  DB_PASSWORD: 'troque-esta-senha'
  JWT_SECRET: 'troque-por-um-segredo-forte-em-producao'
