# Aplicação
PORT=3001
NODE_ENV=development

# JWT (verificação stateless — mesmo segredo do os-service e da oficina-lambda-auth)
JWT_SECRET=troque-por-um-segredo-forte-em-producao

# Banco de dados (PostgreSQL — exclusivo deste serviço: servicos, pecas/estoque)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=oficina_producao
DB_PASSWORD=oficina_producao
DB_DATABASE=oficina_producao

# Observabilidade (New Relic, mesma conta da Fase 3) — desligado por padrão em dev local/CI.
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=oficina-producao-service
